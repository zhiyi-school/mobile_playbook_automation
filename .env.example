# Copy this file to .env and fill in local secrets.
# Do not commit real API keys.

MOBSF_API_KEY="REPLACE_WITH_MOBSF_API_KEY"

# Dashboard sync worker (python -m mobile_playbook.dashboard_sync).
# The service-role key bypasses row-level security: keep it in this worker's
# environment only, never in frontend source, a VITE_ variable, or a bundle.
SUPABASE_URL="REPLACE_WITH_SUPABASE_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# API and CLI runs launch a detached one-shot sync worker after writing their
# terminal manifest. Set this to false only when dashboard sync is not used.
DASHBOARD_SYNC_AUTO_TRIGGER=true

# Comma-separated exact browser origins.
# Leave unset to use the default local Vite origins.
# This is the only key the API process reads from this file; an exported shell
# variable of the same name takes precedence over the value here.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
