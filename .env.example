# Copy this file to .env and fill in local secrets.
# Do not commit real API keys.

MOBSF_API_KEY="REPLACE_WITH_MOBSF_API_KEY"

# Dashboard sync worker (python -m mobile_playbook.dashboard_sync).
# The service-role key bypasses row-level security: keep it in this worker's
# environment only, never in frontend source, a VITE_ variable, or a bundle.
SUPABASE_URL="REPLACE_WITH_SUPABASE_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# API and CLI runs launch a detached one-shot sync worker after writing their
# terminal manifest. Set this to false only when dashboard sync is not used.
DASHBOARD_SYNC_AUTO_TRIGGER=true

# Comma-separated exact browser origins.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Persistent store for derived artifact metadata and icons. See docs/configuration.md.
ARTIFACT_STORE_DIR=""

# Where the developer remediation playbooks live. One directory per platform,
# absolute or relative to the repository root. The backend only ever reads from
# it — it never writes there, and the playbook is not copied into this repo.
# Leave a platform's value empty to fall back to the `playbook_dir` key in that
# platform's configs/split/<platform>/risks.yaml.
IOS_PLAYBOOK_DIR=""
ANDROID_PLAYBOOK_DIR=""

# Whether GET /platforms/{platform}/controls/{control_id}/source/download serves
# the implemented-control archive. Set false on any host reachable beyond the
# trusted LAN; the API has no authentication of its own.
PLAYBOOK_SOURCE_DOWNLOAD_ENABLED=true
