# Template for the local .env file; copy it and fill in secrets, never committing real keys.

MOBSF_API_KEY="REPLACE_WITH_MOBSF_API_KEY"

# Sync worker only, never frontend code; see docs/configuration.md#environment-variables-and-the-secret-boundary.
SUPABASE_URL="REPLACE_WITH_SUPABASE_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# See docs/configuration.md#dashboard_sync_auto_trigger.
DASHBOARD_SYNC_AUTO_TRIGGER=true

# See docs/configuration.md#cors_allowed_origins.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Empty uses artifacts/reports; relative values are anchored to this repository. See docs/storage.md.
REPORTS_DIR=""

# See docs/configuration.md#artifact_store_dir.
ARTIFACT_STORE_DIR=""

# Read-only playbook directories; see docs/configuration.md#ios_playbook_dir-and-android_playbook_dir.
IOS_PLAYBOOK_DIR=""
ANDROID_PLAYBOOK_DIR=""

# To disable source downloads, export PLAYBOOK_SOURCE_DOWNLOAD_ENABLED=false when starting the API.
# The API does not read this key from .env; see docs/configuration.md#playbook_source_download_enabled.

# Optional storage location overrides; see docs/storage.md.
# ARTIFACTS_DIR=./artifacts
# INTAKE_DIR=
# ARTIFACT_STORE_DIR=
# REPORTS_DIR=
# WORK_DIR=

# DEBUG for verbose logs; see docs/configuration.md#log_level.
LOG_LEVEL=INFO
